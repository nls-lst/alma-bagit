# Settings for alma_bag.py. Command-line options override these.

# Alma set IDs to harvest (shown under Manage Sets).
sets = [
    "00000000000000000",  # what this set is
]

# Bag name; {date} becomes YYYYMMDDHHMM.
name = "NLS_BAG_{date}"

# Alma API gateway.
base = "https://api-eu.hosted.exlibrisgroup.com/almaws/v1"

# Output folder.
out = "output"

# Local MARC field listing each file ($a portfolio ID, $b enumeration, $c file name).
portfolio_field = "986"

# Concurrent downloads.
workers = 8

# The API key goes in ALMA_API_KEY or a .env file, not here.
